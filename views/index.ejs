<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="container">
        <h1>Student Management System</h1>

        <a href="/students/add" class="link-btn">Add Student</a>

        <hr>

        <h2>Student List</h2>

        <table>
            <tr>
                <th>ID</th>
                <th>Student ID</th>
                <th>Name</th>
                <th>Course</th>
                <th>Year</th>
                <th>Email</th>
            </tr>

            <% students.forEach(student => { %>
                <tr>
                    <td><%= student.id %></td>
                    <td><%= student.student_id %></td>
                    <td>
                        <%= student.first_name %>
                        <%= student.last_name %>
                    </td>
                    <td><%= student.course %></td>
                    <td><%= student.year_level %></td>
                    <td><%= student.email %></td>
                </tr>
            <% }); %>
        </table>
    </div>
</body>
</html>
